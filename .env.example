# ExamForge · configuración local
# Copia este archivo a .env en la raíz del proyecto.

# Base de datos. SQLite por defecto; para Postgres usa:
# EXAMFORGE_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/examforge
EXAMFORGE_DATABASE_URL=sqlite:///./data/examforge.db

# Archivos subidos
EXAMFORGE_UPLOAD_DIR=./data/uploads
EXAMFORGE_MAX_UPLOAD_MB=25

# LLM: auto | ollama | offline
#   auto    -> usa Ollama si está disponible; si no, cae al generador offline
#   ollama  -> exige Ollama (devuelve 502 si falla)
#   offline -> generador heurístico local, sin LLM (útil para demo/tests)
EXAMFORGE_LLM_PROVIDER=auto
EXAMFORGE_OLLAMA_BASE_URL=http://localhost:11434
EXAMFORGE_OLLAMA_MODEL=qwen2.5:7b
EXAMFORGE_OLLAMA_TIMEOUT_SECONDS=120
EXAMFORGE_LLM_MAX_CONTEXT_CHARS=12000
# Presupuesto de tokens de entrada para controlar coste/tiempo del LLM local.
EXAMFORGE_LLM_MAX_PROMPT_TOKENS=6000

# CORS (el proxy de Vite evita CORS en desarrollo)
EXAMFORGE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Autenticación local. false = perfil local implícito sin registro.
EXAMFORGE_AUTH_REQUIRED=false
EXAMFORGE_AUTH_TOKEN_DAYS=30

# Importación de URLs/YouTube y protección SSRF.
EXAMFORGE_IMPORT_TIMEOUT_SECONDS=30
EXAMFORGE_IMPORT_MAX_CHARS=1000000
EXAMFORGE_IMPORT_ALLOW_PRIVATE_HOSTS=false
EXAMFORGE_YOUTUBE_LANGUAGES=["es","en"]

# OCR opcional de imágenes (requiere tesseract + pytesseract + Pillow).
EXAMFORGE_OCR_ENABLED=true
EXAMFORGE_OCR_LANGUAGE=spa+eng

# Streaming SSE de generación.
EXAMFORGE_STREAMING_ENABLED=true

# Procesamiento en background de archivos grandes (cola in-process).
EXAMFORGE_BACKGROUND_PROCESSING_ENABLED=true
# 0 = procesar siempre en background (útil en tests).
EXAMFORGE_BACKGROUND_PROCESSING_THRESHOLD_MB=2
EXAMFORGE_BACKGROUND_WORKERS=2
EXAMFORGE_BACKGROUND_SHUTDOWN_TIMEOUT_SECONDS=5

# Filas de muestra y perfil para CSV/Parquet.
EXAMFORGE_TABULAR_SAMPLE_ROWS=500

# Cuotas por workspace y límites de subida.
EXAMFORGE_WORKSPACE_MAX_MATERIALS=200
EXAMFORGE_WORKSPACE_MAX_STORAGE_MB=500
EXAMFORGE_WORKSPACE_MAX_EXERCISES=5000
EXAMFORGE_MAX_FILES_PER_UPLOAD=20

# Rate limiting de la API (ventana deslizante en memoria).
EXAMFORGE_RATE_LIMIT_ENABLED=true
EXAMFORGE_RATE_LIMIT_REQUESTS=240
EXAMFORGE_RATE_LIMIT_WINDOW_SECONDS=60

# Auditoría local de operaciones de escritura (tabla audit_logs).
EXAMFORGE_AUDIT_ENABLED=true
EXAMFORGE_AUDIT_MAX_EVENTS=5000

# Copias de seguridad de SQLite (API /api/maintenance y `make backup`).
EXAMFORGE_BACKUP_DIR=./data/backups
EXAMFORGE_BACKUP_MAX_FILES=20

# Caché LRU/TTL de generaciones y métricas locales.
EXAMFORGE_GENERATION_CACHE_ENTRIES=64
EXAMFORGE_GENERATION_CACHE_TTL_SECONDS=900
